{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["agent", "contractVersion", "answers", "unresolved"],
  "properties": {
    "agent": { "type": "object", "required": ["id", "label"], "properties": { "id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "contractVersion": { "const": "processos.furg.br/v2" },
    "answers": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["activityRef", "entryPointRefs", "actionRefs", "operationRefs", "evidenceRefs", "claimStatus"], "properties": { "activityRef": { "type": "string" }, "entryPointRefs": { "type": "array", "items": { "type": "string" } }, "actionRefs": { "type": "array", "items": { "type": "string" } }, "operationRefs": { "type": "array", "items": { "type": "string" } }, "evidenceRefs": { "type": "array", "items": { "type": "string" } }, "claimStatus": { "enum": ["OBSERVED", "IMPLEMENTED", "DOCUMENTED", "INFERRED", "VALIDATED", "CONTESTED"] } }, "additionalProperties": true } },
    "unresolved": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}

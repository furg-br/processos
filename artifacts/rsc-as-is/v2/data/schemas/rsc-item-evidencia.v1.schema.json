{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processos.furg.br/schemas/rsc-item-evidencia.v1.json",
  "title": "Item e comprovante do pedido de RSC",
  "type": "object",
  "required": ["criterio", "fatoGerador", "apuracao", "comprovante", "statusAnalise"],
  "properties": {
    "idItem": { "type": "integer", "minimum": 1 },
    "criterio": { "type": "string", "pattern": "^(I|II|III|IV|V|VI)\\.[0-9]+$" },
    "variante": { "type": ["string", "null"], "enum": ["TITULAR", "SUBSTITUTO", null] },
    "fatoGerador": { "type": "string", "minLength": 1 },
    "dataInicio": { "type": ["string", "null"], "format": "date" },
    "dataFim": { "type": ["string", "null"], "format": "date" },
    "funcaoEmExercicio": { "type": "boolean", "default": false },
    "quantidadeInformada": { "type": "integer", "minimum": 1 },
    "apuracao": { "type": "string", "enum": ["CONTAGEM", "ANO_FRACAO_MAIOR_SEIS_MESES", "MES"] },
    "observacaoServidor": { "type": ["string", "null"] },
    "comprovante": {
      "type": "object",
      "required": ["nomeArquivo", "mimeType", "descricao"],
      "properties": {
        "nomeArquivo": { "type": "string", "pattern": "\\.pdf$" },
        "mimeType": { "const": "application/pdf" },
        "descricao": { "type": "string", "minLength": 1 },
        "hash": { "type": ["string", "null"] },
        "versao": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "statusAnalise": { "type": "string", "enum": ["PENDENTE", "DEFERIDO", "PARCIAL", "INDEFERIDO", "COMPLEMENTACAO", "EXCEDENTE"] },
    "quantidadeReconhecida": { "type": ["integer", "null"], "minimum": 0 },
    "pontosDeferidos": { "type": "number", "minimum": 0 },
    "justificativaAnalise": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}

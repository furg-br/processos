<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:furg="https://processos.furg.br/schema/bpmn/furg/1.0"
  id="Definitions_RSC_AS_IS"
  targetNamespace="https://processos.furg.br/bpmn/rsc-as-is">
  <bpmn:process id="Process_RSC_AS_IS" name="Reconhecer Saberes e Competências - RSC-PCCTAE (AS-IS)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_RSC">
      <bpmn:lane id="Lane_Servidor" name="Servidor requerente">
        <bpmn:flowNodeRef>StartEvent_Eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RespondDiligence</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="SRH / aplicacao RSC">
        <bpmn:flowNodeRef>Activity_Protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RecordDiligence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WaitDiligence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ValidateResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_AutoDeny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinalMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Freeze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SendSei</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SendResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Retry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Commission" name="Comissão RSC">
        <bpmn:flowNodeRef>Activity_Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NeedsDiligence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_OpenDiligence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_FinalOpinion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Accompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ConfirmRetry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sei" name="SEI / PROGEP">
        <bpmn:flowNodeRef>Activity_ReceiveSei</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RouteProgep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Delivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Eligible" name="Servidor elegível decide requerer RSC">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_Instruct" name="Criar e instruir pedido em rascunho">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_Submit" name="Enviar pedido para avaliação">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_02B</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_Protocol" name="Validar, protocolar e publicar memorial">
      <bpmn:incoming>Flow_02B</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_Assign" name="Atribuir responsável pela avaliação">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_Analyze" name="Analisar itens e preparar avaliação">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_NeedsDiligence" name="Diligência necessária?">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_06_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_OpenDiligence" name="Abrir diligência seletiva de 60 dias">
      <bpmn:incoming>Flow_06_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_RecordDiligence" name="Bloquear escopo e notificar servidor">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Gateway_WaitDiligence" name="Resposta no prazo?">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Response</bpmn:outgoing>
      <bpmn:outgoing>Flow_09_Deadline</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_Response" name="Resposta recebida">
      <bpmn:incoming>Flow_09_Response</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Response" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_Deadline" name="Prazo expirado">
      <bpmn:incoming>Flow_09_Deadline</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Deadline">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P60D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Activity_RespondDiligence" name="Corrigir somente alvos liberados e responder">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_ValidateResponse" name="Versionar correções e retornar para análise">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_AutoDeny" name="Indeferir automaticamente por prazo">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_FinalOpinion" name="Registrar Parecer final deferindo ou indeferindo">
      <bpmn:incoming>Flow_06_No</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FinalMerge" name="Parecer terminal registrado">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_Freeze" name="Gerar e congelar dossiê final">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_Accompany" name="Iniciar ou acompanhar envio ao SEI">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_SendSei" name="Criar processo restrito e incluir documentos">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="Activity_ReceiveSei" name="Receber dossiê nato-digital no SEI">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_SendResult" name="Envio concluído?">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22_Success</bpmn:outgoing>
      <bpmn:outgoing>Flow_22_Error</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_ConfirmRetry" name="Verificar SEI e confirmar nova tentativa">
      <bpmn:incoming>Flow_22_Error</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_Retry" name="Retomar envio sem duplicar documentos">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_RouteProgep" name="Tramitar processo para a PROGEP">
      <bpmn:incoming>Flow_22_Success</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Delivered" name="Dossiê entregue; tramitação continua no SEI">
      <bpmn:incoming>Flow_26</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Eligible" targetRef="Activity_Instruct" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Activity_Instruct" targetRef="Activity_Submit" />
    <bpmn:sequenceFlow id="Flow_02B" sourceRef="Activity_Submit" targetRef="Activity_Protocol" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Activity_Protocol" targetRef="Activity_Assign" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Activity_Assign" targetRef="Activity_Analyze" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Activity_Analyze" targetRef="Gateway_NeedsDiligence" />
    <bpmn:sequenceFlow id="Flow_06_Yes" name="Sim" sourceRef="Gateway_NeedsDiligence" targetRef="Activity_OpenDiligence" />
    <bpmn:sequenceFlow id="Flow_06_No" name="Não" sourceRef="Gateway_NeedsDiligence" targetRef="Activity_FinalOpinion" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Activity_OpenDiligence" targetRef="Activity_RecordDiligence" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Activity_RecordDiligence" targetRef="Gateway_WaitDiligence" />
    <bpmn:sequenceFlow id="Flow_09_Response" name="Resposta" sourceRef="Gateway_WaitDiligence" targetRef="Event_Response" />
    <bpmn:sequenceFlow id="Flow_09_Deadline" name="60 dias" sourceRef="Gateway_WaitDiligence" targetRef="Event_Deadline" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_Response" targetRef="Activity_RespondDiligence" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_RespondDiligence" targetRef="Activity_ValidateResponse" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Activity_ValidateResponse" targetRef="Activity_Analyze" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Event_Deadline" targetRef="Activity_AutoDeny" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Activity_AutoDeny" targetRef="Gateway_FinalMerge" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Activity_FinalOpinion" targetRef="Gateway_FinalMerge" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_FinalMerge" targetRef="Activity_Freeze" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Activity_Freeze" targetRef="Activity_Accompany" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Activity_Accompany" targetRef="Activity_SendSei" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Activity_SendSei" targetRef="Activity_ReceiveSei" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Activity_ReceiveSei" targetRef="Gateway_SendResult" />
    <bpmn:sequenceFlow id="Flow_22_Success" name="Sim" sourceRef="Gateway_SendResult" targetRef="Activity_RouteProgep" />
    <bpmn:sequenceFlow id="Flow_22_Error" name="Erro ou retorno incerto" sourceRef="Gateway_SendResult" targetRef="Activity_ConfirmRetry" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Activity_ConfirmRetry" targetRef="Activity_Retry" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Activity_Retry" targetRef="Activity_SendSei" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Activity_RouteProgep" targetRef="EndEvent_Delivered" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_RSC">
    <bpmndi:BPMNPlane id="BPMNPlane_RSC" bpmnElement="Process_RSC_AS_IS">
      <bpmndi:BPMNShape id="Lane_Servidor_di" bpmnElement="Lane_Servidor" isHorizontal="true"><dc:Bounds x="80" y="80" width="4680" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true"><dc:Bounds x="80" y="250" width="4680" height="190" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Commission_di" bpmnElement="Lane_Commission" isHorizontal="true"><dc:Bounds x="80" y="440" width="4680" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sei_di" bpmnElement="Lane_Sei" isHorizontal="true"><dc:Bounds x="80" y="620" width="4680" height="180" /></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_Eligible_di" bpmnElement="StartEvent_Eligible"><dc:Bounds x="150" y="147" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Instruct_di" bpmnElement="Activity_Instruct"><dc:Bounds x="230" y="125" width="210" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Submit_di" bpmnElement="Activity_Submit"><dc:Bounds x="490" y="125" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Protocol_di" bpmnElement="Activity_Protocol"><dc:Bounds x="720" y="300" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Assign_di" bpmnElement="Activity_Assign"><dc:Bounds x="750" y="490" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Analyze_di" bpmnElement="Activity_Analyze"><dc:Bounds x="990" y="490" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_NeedsDiligence_di" bpmnElement="Gateway_NeedsDiligence" isMarkerVisible="true"><dc:Bounds x="1220" y="505" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_OpenDiligence_di" bpmnElement="Activity_OpenDiligence"><dc:Bounds x="1330" y="490" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RecordDiligence_di" bpmnElement="Activity_RecordDiligence"><dc:Bounds x="1570" y="300" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_WaitDiligence_di" bpmnElement="Gateway_WaitDiligence"><dc:Bounds x="1810" y="315" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Response_di" bpmnElement="Event_Response"><dc:Bounds x="1910" y="285" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Deadline_di" bpmnElement="Event_Deadline"><dc:Bounds x="1910" y="380" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RespondDiligence_di" bpmnElement="Activity_RespondDiligence"><dc:Bounds x="2010" y="125" width="210" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ValidateResponse_di" bpmnElement="Activity_ValidateResponse"><dc:Bounds x="2280" y="300" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_AutoDeny_di" bpmnElement="Activity_AutoDeny"><dc:Bounds x="2020" y="350" width="180" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_FinalOpinion_di" bpmnElement="Activity_FinalOpinion"><dc:Bounds x="1900" y="500" width="220" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_FinalMerge_di" bpmnElement="Gateway_FinalMerge" isMarkerVisible="true"><dc:Bounds x="2510" y="315" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Freeze_di" bpmnElement="Activity_Freeze"><dc:Bounds x="2630" y="300" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Accompany_di" bpmnElement="Activity_Accompany"><dc:Bounds x="2870" y="490" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_SendSei_di" bpmnElement="Activity_SendSei"><dc:Bounds x="3130" y="300" width="200" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ReceiveSei_di" bpmnElement="Activity_ReceiveSei"><dc:Bounds x="3390" y="670" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SendResult_di" bpmnElement="Gateway_SendResult" isMarkerVisible="true"><dc:Bounds x="3650" y="315" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ConfirmRetry_di" bpmnElement="Activity_ConfirmRetry"><dc:Bounds x="3760" y="490" width="200" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Retry_di" bpmnElement="Activity_Retry"><dc:Bounds x="4020" y="300" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RouteProgep_di" bpmnElement="Activity_RouteProgep"><dc:Bounds x="3760" y="670" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Delivered_di" bpmnElement="EndEvent_Delivered"><dc:Bounds x="4050" y="692" width="36" height="36" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="186" y="165" /><di:waypoint x="230" y="165" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="440" y="165" /><di:waypoint x="490" y="165" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02B_di" bpmnElement="Flow_02B"><di:waypoint x="680" y="165" /><di:waypoint x="700" y="165" /><di:waypoint x="700" y="340" /><di:waypoint x="720" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="910" y="340" /><di:waypoint x="940" y="340" /><di:waypoint x="940" y="460" /><di:waypoint x="840" y="460" /><di:waypoint x="840" y="490" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="930" y="530" /><di:waypoint x="990" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="1170" y="530" /><di:waypoint x="1220" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_Yes_di" bpmnElement="Flow_06_Yes"><di:waypoint x="1270" y="530" /><di:waypoint x="1330" y="530" /><bpmndi:BPMNLabel><dc:Bounds x="1285" y="510" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_No_di" bpmnElement="Flow_06_No"><di:waypoint x="1245" y="555" /><di:waypoint x="1245" y="600" /><di:waypoint x="1870" y="600" /><di:waypoint x="1870" y="540" /><di:waypoint x="1900" y="540" /><bpmndi:BPMNLabel><dc:Bounds x="1280" y="580" width="26" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="1520" y="530" /><di:waypoint x="1540" y="530" /><di:waypoint x="1540" y="340" /><di:waypoint x="1570" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08"><di:waypoint x="1750" y="340" /><di:waypoint x="1810" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_Response_di" bpmnElement="Flow_09_Response"><di:waypoint x="1860" y="340" /><di:waypoint x="1885" y="340" /><di:waypoint x="1885" y="303" /><di:waypoint x="1910" y="303" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_Deadline_di" bpmnElement="Flow_09_Deadline"><di:waypoint x="1835" y="365" /><di:waypoint x="1835" y="398" /><di:waypoint x="1910" y="398" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1928" y="285" /><di:waypoint x="1928" y="165" /><di:waypoint x="2010" y="165" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="2220" y="165" /><di:waypoint x="2250" y="165" /><di:waypoint x="2250" y="340" /><di:waypoint x="2280" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="2375" y="380" /><di:waypoint x="2375" y="610" /><di:waypoint x="1080" y="610" /><di:waypoint x="1080" y="570" /></bpmndi:BPMNEdge>

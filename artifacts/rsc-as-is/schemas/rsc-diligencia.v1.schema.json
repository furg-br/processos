{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processos.furg.br/schemas/rsc-diligencia.v1.json",
  "title": "Diligência seletiva do RSC",
  "type": "object",
  "required": ["origem", "motivo", "prazo", "alvos", "status"],
  "properties": {
    "idDiligencia": { "type": "integer", "minimum": 1 },
    "origem": { "const": "ANALISE" },
    "motivo": { "type": "string", "minLength": 1 },
    "prazo": { "type": "string", "format": "date" },
    "alvos": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["tipo"],
        "properties": {
          "tipo": { "type": "string", "enum": ["CAMPO", "SECAO_MEMORIAL", "ITEM", "COMPROVANTE", "PRIORIDADE"] },
          "idReferencia": { "type": ["integer", "null"], "minimum": 1 },
          "codigo": { "type": ["string", "null"] },
          "corrigido": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      }
    },
    "descricaoResposta": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["ABERTA", "RESPONDIDA", "EXPIRADA"] }
  },
  "additionalProperties": false
}

  "informationSchemas": [
    {
      "id": "21000000-0000-4000-8000-000000000001",
      "assetId": "20000000-0000-4000-8000-000000000001",
      "name": "Pedido de RSC-PCCTAE",
      "version": 1,
      "visibility": "INTERNAL",
      "jsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://processos.furg.br/schemas/rsc-pedido.v1.json",
        "title": "Pedido de RSC-PCCTAE",
        "description": "Contrato conceitual dos dados cadastrais e do estado principal do pedido implementado no SRH.",
        "type": "object",
        "required": [
          "idPedido",
          "idFuncionario",
          "nivelPleiteado",
          "memorial",
          "declaracoes",
          "statusPrincipal"
        ],
        "properties": {
          "idPedido": {
            "type": "integer",
            "minimum": 1
          },
          "idFuncionario": {
            "type": "integer",
            "minimum": 1
          },
          "catalogoVersao": {
            "type": "integer",
            "minimum": 1
          },
          "nivelPleiteado": {
            "type": "string",
            "enum": [
              "I",
              "II",
              "III",
              "IV",
              "V",
              "VI"
            ]
          },
          "memorial": {
            "type": "string",
            "minLength": 1,
            "description": "HTML básico sanitizado; torna-se público no protocolo."
          },
          "email": {
            "type": "string",
            "format": "email",
            "readOnly": true
          },
          "telefone": {
            "type": "string",
            "minLength": 1,
            "readOnly": true
          },
          "processoRscAnterior": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "numero": {
                "type": "string"
              },
              "pontosSaldoDeclarado": {
                "type": "number",
                "minimum": 0
              },
              "pontosSaldoReconhecido": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "declaracoes": {
            "type": "object",
            "required": [
              "exercicioCargo",
              "naoReutilizacao",
              "autenticidade",
              "responsabilidade"
            ],
            "properties": {
              "exercicioCargo": {
                "const": true
              },
              "naoReutilizacao": {
                "const": true
              },
              "autenticidade": {
                "const": true
              },
              "responsabilidade": {
                "const": true
              }
            },
            "additionalProperties": false
          },
          "statusPrincipal": {
            "type": "string",
            "enum": [
              "RASCUNHO",
              "EM_ANALISE",
              "EM_DILIGENCIA",
              "DEFERIDO",
              "INDEFERIDO"
            ]
          },
          "responsavelAvaliacao": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "dataProtocolo": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "dataDecisao": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "versaoFinal": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "createdAt": "2026-08-16T21:00:00.000Z"
    },

{
  "$ref": "#/definitions/ProcessRelease",
  "definitions": {
    "ProcessRelease": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "processos.furg.br/v2"
        },
        "kind": {
          "type": "string",
          "const": "ProcessRelease"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "key": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
              "errorMessage": {
                "pattern": "Use uma chave semântica estável em minúsculas."
              }
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "visibility": {
              "type": "string",
              "enum": [
                "PUBLIC",
                "INSTITUTIONAL",
                "TECHNICAL",
                "RESTRICTED"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "DRAFT",
                "IN_REVIEW",
                "PUBLISHED",
                "SUPERSEDED",
                "ARCHIVED"
              ],
              "default": "DRAFT"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            }
          },
          "required": [
            "id",
            "key",
            "version",
            "visibility",
            "title",
            "createdAt",
            "updatedAt"
          ],
          "additionalProperties": false
        },
        "spec": {
          "type": "object",
          "properties": {
            "releaseId": {
              "type": "string",
              "format": "uuid"
            },
            "processDefinitionRef": {
              "$ref": "#/definitions/ProcessRelease/properties/metadata/properties/key"
            },
            "processVersionId": {
              "type": "string",
              "format": "uuid"
            },
            "bindingSetVersionId": {
              "type": "string",
              "format": "uuid"
            },
            "publishedAt": {
              "type": "string",
              "format": "date-time"
            },
            "effectiveFrom": {
              "type": "string",
              "format": "date-time"
            },
            "effectiveUntil": {
              "type": "string",
              "format": "date-time"
            },
            "sourceArtifactRefs": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ProcessRelease/properties/metadata/properties/key"
              },
              "default": []
            }
          },
          "required": [
            "releaseId",
            "processDefinitionRef",
            "processVersionId",
            "bindingSetVersionId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processos.furg.br/schemas/v2/release.schema.json"
}

{
  "$ref": "#/definitions/AccessCatalog",
  "definitions": {
    "AccessCatalog": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "processos.furg.br/v2"
        },
        "kind": {
          "type": "string",
          "const": "AccessCatalog"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "key": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
              "errorMessage": {
                "pattern": "Use uma chave semântica estável em minúsculas."
              }
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "visibility": {
              "type": "string",
              "enum": [
                "PUBLIC",
                "INSTITUTIONAL",
                "TECHNICAL",
                "RESTRICTED"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "DRAFT",
                "IN_REVIEW",
                "PUBLISHED",
                "SUPERSEDED",
                "ARCHIVED"
              ],
              "default": "DRAFT"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            }
          },
          "required": [
            "id",
            "key",
            "version",
            "visibility",
            "title",
            "createdAt",
            "updatedAt"
          ],
          "additionalProperties": false
        },
        "spec": {
          "type": "object",
          "properties": {
            "actors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/definitions/AccessCatalog/properties/metadata/properties/key"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "PERSON",
                      "AFFILIATION",
                      "POSITION",
                      "ORGANIZATIONAL_ROLE",
                      "SYSTEM_ACTOR"
                    ]
                  }
                },
                "required": [
                  "key",
                  "label",
                  "kind"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "profiles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/definitions/AccessCatalog/properties/metadata/properties/key"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "groupRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/AccessCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  },
                  "sourceSystemRef": {
                    "$ref": "#/definitions/AccessCatalog/properties/metadata/properties/key"
                  }
                },
                "required": [
                  "key",
                  "label"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/definitions/AccessCatalog/properties/metadata/properties/key"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "grantRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/AccessCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  },
                  "sourceSystemRef": {
                    "$ref": "#/definitions/AccessCatalog/properties/metadata/properties/key"
                  }
                },
                "required": [
                  "key",
                  "label"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "grants": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/definitions/AccessCatalog/properties/metadata/properties/key"
                  },
                  "subjectRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/AccessCatalog/properties/metadata/properties/key"
                    },
                    "minItems": 1
                  },
                  "actionRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/AccessCatalog/properties/metadata/properties/key"
                    },
                    "minItems": 1
                  },
                  "resourceRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/AccessCatalog/properties/metadata/properties/key"
                    },
                    "minItems": 1
                  },
                  "policyRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/AccessCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  }
                },
                "required": [
                  "key",
                  "subjectRefs",
                  "actionRefs",
                  "resourceRefs"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "policies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/definitions/AccessCatalog/properties/metadata/properties/key"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "layer": {
                    "type": "string",
                    "enum": [
                      "CAPABILITY",
                      "STATE",
                      "RECORD_SCOPE",
                      "FIELD_DOCUMENT"
                    ]
                  },
                  "effect": {
                    "type": "string",
                    "enum": [
                      "ALLOW",
                      "DENY"
                    ]
                  },
                  "expressionLanguage": {
                    "type": "string",
                    "enum": [
                      "CEL",
                      "JSON_LOGIC",
                      "FEEL",
                      "NARRATIVE"
                    ]
                  },
                  "expression": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidenceRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/AccessCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  }
                },
                "required": [
                  "key",
                  "label",
                  "layer",
                  "effect",
                  "expressionLanguage",
                  "expression",
                  "description"
                ],
                "additionalProperties": false
              },
              "default": []
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processos.furg.br/schemas/v2/access.schema.json"
}

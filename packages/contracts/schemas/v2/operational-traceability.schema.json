{
  "$ref": "#/definitions/OperationalTraceabilityCatalog",
  "definitions": {
    "OperationalTraceabilityCatalog": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "processos.furg.br/v2"
        },
        "kind": {
          "type": "string",
          "const": "OperationalTraceabilityCatalog"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "key": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
              "errorMessage": {
                "pattern": "Use uma chave semântica estável em minúsculas."
              }
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "visibility": {
              "type": "string",
              "enum": [
                "PUBLIC",
                "INSTITUTIONAL",
                "TECHNICAL",
                "RESTRICTED"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "DRAFT",
                "IN_REVIEW",
                "PUBLISHED",
                "SUPERSEDED",
                "ARCHIVED"
              ],
              "default": "DRAFT"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            }
          },
          "required": [
            "id",
            "key",
            "version",
            "visibility",
            "title",
            "createdAt",
            "updatedAt"
          ],
          "additionalProperties": false
        },
        "spec": {
          "type": "object",
          "properties": {
            "activities": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "activityRef": {
                    "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                  },
                  "executionMode": {
                    "type": "string",
                    "enum": [
                      "HUMAN_UI",
                      "HUMAN_EXTERNAL",
                      "AUTOMATED",
                      "HYBRID",
                      "INTEGRATION"
                    ]
                  },
                  "actorRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  },
                  "organizationUnitRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  },
                  "interactionPointRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  },
                  "completionActions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "COMPLETE",
                            "OUTCOME",
                            "CANCEL",
                            "RETRY"
                          ]
                        },
                        "targetFlowRef": {
                          "type": "string"
                        },
                        "operationRefs": {
                          "type": "array",
                          "items": {
                            "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                          },
                          "default": []
                        },
                        "formRefs": {
                          "type": "array",
                          "items": {
                            "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                          },
                          "default": []
                        },
                        "policyRefs": {
                          "type": "array",
                          "items": {
                            "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                          },
                          "default": []
                        },
                        "preconditions": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "key": {
                                "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                              },
                              "expressionLanguage": {
                                "type": "string",
                                "enum": [
                                  "CEL",
                                  "JSON_LOGIC",
                                  "FEEL",
                                  "NARRATIVE"
                                ]
                              },
                              "expression": {
                                "type": "string",
                                "minLength": 1
                              },
                              "description": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "key",
                              "expressionLanguage",
                              "expression",
                              "description"
                            ],
                            "additionalProperties": false
                          },
                          "default": []
                        },
                        "effects": {
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "const": "STATE_TRANSITION"
                                  },
                                  "stateMachineRef": {
                                    "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                                  },
                                  "from": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "to": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": [
                                  "type",
                                  "from",
                                  "to"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "const": "START_ACTIVITY"
                                  },
                                  "activityRef": {
                                    "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                                  }
                                },
                                "required": [
                                  "type",
                                  "activityRef"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "const": "EMIT_EVENT"
                                  },
                                  "eventRef": {
                                    "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                                  }
                                },
                                "required": [
                                  "type",
                                  "eventRef"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "const": "CREATE_DATA"
                                  },
                                  "dataRef": {
                                    "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                                  }
                                },
                                "required": [
                                  "type",
                                  "dataRef"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "const": "UPDATE_DATA"
                                  },
                                  "dataRef": {
                                    "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                                  }
                                },
                                "required": [
                                  "type",
                                  "dataRef"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "const": "GENERATE_DOCUMENT"
                                  },
                                  "documentRef": {
                                    "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                                  }
                                },
                                "required": [
                                  "type",
                                  "documentRef"
                                ],
                                "additionalProperties": false
                              }
                            ]
                          },
                          "default": []
                        },
                        "evidenceRefs": {
                          "type": "array",
                          "items": {
                            "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                          },
                          "default": []
                        }
                      },
                      "required": [
                        "key",
                        "label",
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    "default": []
                  },
                  "inputRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  },
                  "outputRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  },
                  "timingPolicyRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  },
                  "evidenceRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  },
                  "externalProcedure": {
                    "type": "object",
                    "properties": {
                      "location": {
                        "type": "string",
                        "minLength": 1
                      },
                      "procedureRef": {
                        "$ref": "#/definitions/OperationalTraceabilityCatalog/properties/metadata/properties/key"
                      }
                    },
                    "required": [
                      "location"
                    ],
                    "additionalProperties": false
                  },
                  "mappingStatus": {
                    "type": "string",
                    "enum": [
                      "COMPLETE",
                      "PARTIAL",
                      "NOT_APPLICABLE",
                      "UNKNOWN"
                    ]
                  },
                  "gapReason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "activityRef",
                  "executionMode",
                  "mappingStatus"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "activities"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processos.furg.br/schemas/v2/operational-traceability.schema.json"
}

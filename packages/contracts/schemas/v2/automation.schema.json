{
  "$ref": "#/definitions/AutomationCatalog",
  "definitions": {
    "AutomationCatalog": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "processos.furg.br/v2"
        },
        "kind": {
          "type": "string",
          "const": "AutomationCatalog"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "key": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
              "errorMessage": {
                "pattern": "Use uma chave semântica estável em minúsculas."
              }
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "visibility": {
              "type": "string",
              "enum": [
                "PUBLIC",
                "INSTITUTIONAL",
                "TECHNICAL",
                "RESTRICTED"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "DRAFT",
                "IN_REVIEW",
                "PUBLISHED",
                "SUPERSEDED",
                "ARCHIVED"
              ],
              "default": "DRAFT"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            }
          },
          "required": [
            "id",
            "key",
            "version",
            "visibility",
            "title",
            "createdAt",
            "updatedAt"
          ],
          "additionalProperties": false
        },
        "spec": {
          "type": "object",
          "properties": {
            "timingPolicies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/definitions/AutomationCatalog/properties/metadata/properties/key"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "LEGAL_DEADLINE",
                      "EXPECTED_DURATION",
                      "INTERNAL_SLA"
                    ]
                  },
                  "duration": {
                    "type": "string",
                    "minLength": 1
                  },
                  "calendarRef": {
                    "$ref": "#/definitions/AutomationCatalog/properties/metadata/properties/key"
                  },
                  "timezone": {
                    "type": "string",
                    "minLength": 1
                  },
                  "trigger": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pauseConditions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "warnings": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "publicLabel": {
                    "type": "string"
                  },
                  "normativeBasisRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/AutomationCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  }
                },
                "required": [
                  "key",
                  "label",
                  "kind",
                  "duration",
                  "timezone",
                  "trigger"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "jobs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/definitions/AutomationCatalog/properties/metadata/properties/key"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "schedule": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timezone": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operationRef": {
                    "$ref": "#/definitions/AutomationCatalog/properties/metadata/properties/key"
                  },
                  "executor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ownerUnitRef": {
                    "$ref": "#/definitions/AutomationCatalog/properties/metadata/properties/key"
                  },
                  "idempotency": {
                    "type": "string",
                    "minLength": 1
                  },
                  "concurrencyLock": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryPolicy": {
                    "type": "string",
                    "minLength": 1
                  },
                  "monitoring": {
                    "type": "string",
                    "minLength": 1
                  },
                  "configurationRequirements": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "secretRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/AutomationCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  }
                },
                "required": [
                  "key",
                  "label",
                  "schedule",
                  "timezone",
                  "operationRef",
                  "executor",
                  "ownerUnitRef",
                  "idempotency",
                  "concurrencyLock",
                  "retryPolicy",
                  "monitoring"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "integrations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/definitions/AutomationCatalog/properties/metadata/properties/key"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sourceSystemRef": {
                    "$ref": "#/definitions/AutomationCatalog/properties/metadata/properties/key"
                  },
                  "targetSystemRef": {
                    "$ref": "#/definitions/AutomationCatalog/properties/metadata/properties/key"
                  },
                  "operationRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/AutomationCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  },
                  "protocol": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "key",
                  "label",
                  "sourceSystemRef",
                  "targetSystemRef",
                  "protocol"
                ],
                "additionalProperties": false
              },
              "default": []
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processos.furg.br/schemas/v2/automation.schema.json"
}

{
  "$ref": "#/definitions/FormCatalog",
  "definitions": {
    "FormCatalog": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "processos.furg.br/v2"
        },
        "kind": {
          "type": "string",
          "const": "FormCatalog"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "key": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
              "errorMessage": {
                "pattern": "Use uma chave semântica estável em minúsculas."
              }
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "visibility": {
              "type": "string",
              "enum": [
                "PUBLIC",
                "INSTITUTIONAL",
                "TECHNICAL",
                "RESTRICTED"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "DRAFT",
                "IN_REVIEW",
                "PUBLISHED",
                "SUPERSEDED",
                "ARCHIVED"
              ],
              "default": "DRAFT"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            }
          },
          "required": [
            "id",
            "key",
            "version",
            "visibility",
            "title",
            "createdAt",
            "updatedAt"
          ],
          "additionalProperties": false
        },
        "spec": {
          "type": "object",
          "properties": {
            "forms": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/definitions/FormCatalog/properties/metadata/properties/key"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dataSchemaRef": {
                    "$ref": "#/definitions/FormCatalog/properties/metadata/properties/key"
                  },
                  "uiSchemaDialect": {
                    "type": "string",
                    "minLength": 1
                  },
                  "activityRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/FormCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  },
                  "actionRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/FormCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  },
                  "audienceRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/FormCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "component": {
                          "type": "string",
                          "minLength": 1
                        },
                        "access": {
                          "type": "string",
                          "enum": [
                            "EDITABLE",
                            "READ_ONLY",
                            "DERIVED",
                            "HIDDEN"
                          ]
                        },
                        "policyRefs": {
                          "type": "array",
                          "items": {
                            "$ref": "#/definitions/FormCatalog/properties/metadata/properties/key"
                          },
                          "default": []
                        },
                        "visibilityRule": {
                          "type": "string"
                        },
                        "requiredRule": {
                          "type": "string"
                        },
                        "ruleLanguage": {
                          "type": "string",
                          "enum": [
                            "CEL",
                            "JSON_LOGIC",
                            "FEEL",
                            "NARRATIVE"
                          ]
                        }
                      },
                      "required": [
                        "path",
                        "label",
                        "component",
                        "access"
                      ],
                      "additionalProperties": false
                    },
                    "default": []
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/FormCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  }
                },
                "required": [
                  "key",
                  "label",
                  "version",
                  "dataSchemaRef",
                  "uiSchemaDialect"
                ],
                "additionalProperties": false
              },
              "default": []
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processos.furg.br/schemas/v2/forms.schema.json"
}

{
  "$ref": "#/definitions/SoftwareCatalog",
  "definitions": {
    "SoftwareCatalog": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "processos.furg.br/v2"
        },
        "kind": {
          "type": "string",
          "const": "SoftwareCatalog"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "key": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
              "errorMessage": {
                "pattern": "Use uma chave semântica estável em minúsculas."
              }
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "visibility": {
              "type": "string",
              "enum": [
                "PUBLIC",
                "INSTITUTIONAL",
                "TECHNICAL",
                "RESTRICTED"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "DRAFT",
                "IN_REVIEW",
                "PUBLISHED",
                "SUPERSEDED",
                "ARCHIVED"
              ],
              "default": "DRAFT"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            }
          },
          "required": [
            "id",
            "key",
            "version",
            "visibility",
            "title",
            "createdAt",
            "updatedAt"
          ],
          "additionalProperties": false
        },
        "spec": {
          "type": "object",
          "properties": {
            "systems": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/definitions/SoftwareCatalog/properties/metadata/properties/key"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ownerUnitRef": {
                    "$ref": "#/definitions/SoftwareCatalog/properties/metadata/properties/key"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "label"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/definitions/SoftwareCatalog/properties/metadata/properties/key"
                  },
                  "systemRef": {
                    "$ref": "#/definitions/SoftwareCatalog/properties/metadata/properties/key"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "key",
                  "systemRef",
                  "label"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "entryPoints": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/definitions/SoftwareCatalog/properties/metadata/properties/key"
                  },
                  "systemRef": {
                    "$ref": "#/definitions/SoftwareCatalog/properties/metadata/properties/key"
                  },
                  "moduleRef": {
                    "$ref": "#/definitions/SoftwareCatalog/properties/metadata/properties/key"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "screenRef": {
                    "$ref": "#/definitions/SoftwareCatalog/properties/metadata/properties/key"
                  },
                  "menuPath": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "default": []
                  },
                  "environmentUrls": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "format": "uri"
                    },
                    "default": {}
                  },
                  "evidenceRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/SoftwareCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  }
                },
                "required": [
                  "key",
                  "systemRef",
                  "label"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "operations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/definitions/SoftwareCatalog/properties/metadata/properties/key"
                  },
                  "systemRef": {
                    "$ref": "#/definitions/SoftwareCatalog/properties/metadata/properties/key"
                  },
                  "moduleRef": {
                    "$ref": "#/definitions/SoftwareCatalog/properties/metadata/properties/key"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "HTTP",
                      "UI_COMMAND",
                      "MESSAGE",
                      "CRON",
                      "INTERNAL",
                      "MANUAL"
                    ]
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "method": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "handler": {
                    "type": "string"
                  },
                  "deprecated": {
                    "type": "boolean",
                    "default": false
                  },
                  "evidenceRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/SoftwareCatalog/properties/metadata/properties/key"
                    },
                    "default": []
                  }
                },
                "required": [
                  "key",
                  "systemRef",
                  "label",
                  "kind",
                  "version"
                ],
                "additionalProperties": false
              },
              "default": []
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processos.furg.br/schemas/v2/software.schema.json"
}
